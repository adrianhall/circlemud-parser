{
  "name": "@adrianhall/circlemud-parser",
  "version": "0.1.0",
  "description": "Parse CircleMUD/TbaMUD world data files into JSON.",
  "license": "MIT",
  "author": "Adrian Hall",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianhall/circlemud-parser.git"
  },
  "bugs": {
    "url": "https://github.com/adrianhall/circlemud-parser/issues"
  },
  "homepage": "https://github.com/adrianhall/circlemud-parser#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "circlemud-parser": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "run-s check:* test:coverage",
    "check-only": "run-s check:*",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit",
    "dev": "tsx watch src/cli.ts",
    "fix": "run-s fix:*",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "prepare": "husky || true && tsup",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.6"
  }
}
